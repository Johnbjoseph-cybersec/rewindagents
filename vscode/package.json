{
  "name": "rewindagents",
  "displayName": "rewindagents",
  "description": "Undo for AI coding agents in your editor: a per-step timeline of what the agent did, each step's diff, preview rewind and rewind to here. Uses the rewindagents CLI.",
  "version": "1.1.0",
  "publisher": "rewindagents",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Johnbjoseph-cybersec/rewindagents.git",
    "directory": "vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.rewindagents/log.jsonl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rewindagents.refresh",
        "title": "Rewind Agents: Refresh Timeline"
      },
      {
        "command": "rewindagents.previewRewind",
        "title": "Rewind Agents: Preview Rewind"
      },
      {
        "command": "rewindagents.rewindToHere",
        "title": "Rewind Agents: Rewind To Here"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "rewindagentsTimeline",
          "name": "Rewind Timeline"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "rewindagents.refresh",
          "when": "view == rewindagentsTimeline",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "rewindagents.previewRewind",
          "when": "view == rewindagentsTimeline && viewItem == rewindStep",
          "group": "inline"
        },
        {
          "command": "rewindagents.rewindToHere",
          "when": "view == rewindagentsTimeline && viewItem == rewindStep",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Rewind Agents",
      "properties": {
        "rewindagents.cliPath": {
          "type": "string",
          "default": "rewindagents",
          "description": "Path to the rewindagents command. Set this if the executable is not on PATH."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "vitest run",
    "package": "mkdir -p dist && vsce package --out dist/"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "3.9.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.12"
  },
  "icon": "icon.png",
  "homepage": "https://github.com/Johnbjoseph-cybersec/rewindagents",
  "bugs": {
    "url": "https://github.com/Johnbjoseph-cybersec/rewindagents/issues"
  },
  "keywords": [
    "undo",
    "rewind",
    "claude code",
    "codex",
    "cursor",
    "ai agent",
    "checkpoint",
    "mcp"
  ],
  "galleryBanner": {
    "color": "#121412",
    "theme": "dark"
  }
}
